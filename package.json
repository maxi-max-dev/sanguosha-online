{
  "name": "sgs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @sgs/web dev",
    "dev:server": "pnpm --filter @sgs/server dev",
    "build": "pnpm --filter @sgs/web build",
    "soak": "pnpm --filter @sgs/engine soak",
    "cf:login": "pnpm --filter @sgs/server exec wrangler login",
    "cf:whoami": "pnpm --filter @sgs/server exec wrangler whoami",
    "cf:deploy": "pnpm --filter @sgs/web build && pnpm --filter @sgs/server exec wrangler deploy"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
